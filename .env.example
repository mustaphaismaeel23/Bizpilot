# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/bizpilot?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# App
NODE_ENV="development"

# Optional local account bootstrap for `npm run seed` (development only)
# DEV_SEED_EMAIL="developer@example.com"
# DEV_SEED_PASSWORD="choose-a-unique-password-of-12-chars-or-more"
# DEV_SEED_NAME="Local Developer"
# DEV_SEED_BUSINESS="Local Development Business"
